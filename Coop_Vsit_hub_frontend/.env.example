# Cooperative Bank of Oromia - Frontend Environment Variables Example

# Backend API Endpoint URL
VITE_API_URL=http://localhost:8080

# Frontend Development Server Port
VITE_PORT=3000

# MailHog Web UI URL
VITE_MAILHOG_URL=http://localhost:8025

# Swagger API Documentation URL
VITE_SWAGGER_URL=http://localhost:8080/swagger-ui/index.html
