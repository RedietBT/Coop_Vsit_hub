# =============================================================================
# EXAMPLE CONFIGURATION TEMPLATE - TRACKED BY GIT
# Copy this file to application.properties and customize secret keys and credentials.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO GIT REPOSITORIES.
# =============================================================================

spring.application.name=Coop_Vsit_hub

# Database Credentials
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/coop_visit_db}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:coop_user}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:coop_secure_pass}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA & Migration Settings
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

# MailHog / SMTP Credentials
spring.mail.host=${SPRING_MAIL_HOST:localhost}
spring.mail.port=${SPRING_MAIL_PORT:1025}
spring.mail.username=${SPRING_MAIL_USERNAME:}
spring.mail.password=${SPRING_MAIL_PASSWORD:}
spring.mail.from=${SPRING_MAIL_FROM:no-reply@coopbank.com.et}
spring.mail.properties.mail.smtp.auth=${SPRING_MAIL_AUTH:false}
spring.mail.properties.mail.smtp.starttls.enable=${SPRING_MAIL_STARTTLS:false}

# Application Base URL
coopbank.app.base-url=${APP_BASE_URL:http://localhost:8080}

# File Limits
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# Security & Secret Keys (REPLACE WITH STRONG PRODUCTION RANDOM KEY)
coopbank.security.jwt.secret=${JWT_SECRET:404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970}
coopbank.security.jwt.access-token-expiration-ms=900000
coopbank.security.jwt.refresh-token-expiration-ms=604800000
coopbank.security.brute-force.max-attempts=5
coopbank.security.brute-force.lock-duration-minutes=15
coopbank.security.rate-limit.requests-per-minute=60

# Swagger UI Access Credentials
coopbank.security.swagger.username=${SWAGGER_ADMIN_USER:coop_admin}
coopbank.security.swagger.password=${SWAGGER_ADMIN_PASS:CoopBank#DxValley2026!}

# Springdoc OpenAPI / Swagger UI Settings
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operations-sorter=alpha
springdoc.swagger-ui.tags-sorter=alpha
springdoc.swagger-ui.display-request-duration=true
springdoc.swagger-ui.doc-expansion=none
springdoc.api-docs.path=/v3/api-docs

# Server Port (Render injects dynamic PORT)
server.port=${PORT:8080}
server.error.include-message=always
server.error.include-binding-errors=always
