# =============================================================================
# EXAMPLE CONFIGURATION TEMPLATE - TRACKED BY GIT
# Copy this file to application.properties or define variables in your .env file.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO GIT REPOSITORIES.
# =============================================================================

spring.application.name=Coop_Vsit_hub
spring.config.import=optional:file:.env[.properties],optional:file:../.env[.properties]

# Database Credentials
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/coop_visit_db}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA & Migration Settings
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
spring.flyway.validate-on-migrate=false
spring.flyway.ignore-migration-patterns=*:*

# SMTP Credentials
spring.mail.host=${SPRING_MAIL_HOST:smtp.example.com}
spring.mail.port=${SPRING_MAIL_PORT:587}
spring.mail.username=${SPRING_MAIL_USERNAME:noreply@example.com}
spring.mail.password=${SPRING_MAIL_PASSWORD}
spring.mail.from=${SPRING_MAIL_FROM:noreply@example.com}
spring.mail.properties.mail.smtp.auth=${SPRING_MAIL_AUTH:true}
spring.mail.properties.mail.smtp.starttls.enable=${SPRING_MAIL_STARTTLS:true}
spring.mail.properties.mail.smtp.starttls.required=${SPRING_MAIL_STARTTLS_REQUIRED:true}
spring.mail.properties.mail.smtp.ssl.trust=${SPRING_MAIL_SSL_TRUST:*}
spring.mail.properties.mail.smtp.ssl.checkserveridentity=${SPRING_MAIL_SSL_CHECKSERVERIDENTITY:false}

# Application Base URL
coopbank.app.base-url=${APP_BASE_URL:http://localhost:8080}

# File Upload Directories (resolved to absolute path at startup)
coopbank.files.upload-dir=${FILE_UPLOAD_DIR:uploads/attachments/}
coopbank.rooms.upload-dir=${ROOMS_UPLOAD_DIR:uploads/rooms/}

# File Limits
spring.servlet.multipart.max-file-size=15MB
spring.servlet.multipart.max-request-size=20MB

# Security & Secret Keys (Loaded from .env / Environment Variables)
coopbank.security.jwt.secret=${JWT_SECRET}
coopbank.security.jwt.access-token-expiration-ms=${JWT_ACCESS_TOKEN_EXPIRATION_MS:900000}
coopbank.security.jwt.refresh-token-expiration-ms=${JWT_REFRESH_TOKEN_EXPIRATION_MS:604800000}
coopbank.security.brute-force.max-attempts=5
coopbank.security.brute-force.lock-duration-minutes=15
coopbank.security.rate-limit.requests-per-minute=60

# Swagger UI Access Credentials
coopbank.security.swagger.username=${SWAGGER_ADMIN_USER:admin}
coopbank.security.swagger.password=${SWAGGER_ADMIN_PASS}

# Springdoc OpenAPI / Swagger UI Settings
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operations-sorter=alpha
springdoc.swagger-ui.tags-sorter=alpha
springdoc.swagger-ui.display-request-duration=true
springdoc.swagger-ui.doc-expansion=none
springdoc.api-docs.path=/v3/api-docs

# Server Port
server.port=${PORT:8080}
server.error.include-message=always
server.error.include-binding-errors=always

# Frontend Application URL for Guest Feedback & Redirects
coopbank.app.frontend-url=${COOPBANK_APP_FRONTEND_URL:${FRONTEND_URL:http://localhost:3000}}
app.frontend.url=${APP_FRONTEND_URL:${FRONTEND_URL:http://localhost:3000}}

# CORS Allowed Origins
coopbank.security.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:3001,http://localhost:5173}

# Active Directory (AD / LDAPS) Integration Settings
coopbank.ad.enabled=${AD_ENABLED:false}
coopbank.ad.domain=${AD_DOMAIN:example.local}
coopbank.ad.url=${AD_URL:ldaps://ldap.example.com:636}
coopbank.ad.base-dn=${AD_BASE_DN:DC=example,DC=local}
coopbank.ad.username=${AD_USERNAME:}
coopbank.ad.password=${AD_PASSWORD:}
coopbank.ad.ssl.trust-all=${AD_SSL_TRUST_ALL:false}
