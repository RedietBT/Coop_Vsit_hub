# =============================================================================
# EXAMPLE CONFIGURATION TEMPLATE - TRACKED BY GIT
# Copy this file to application.properties and customize secret keys and credentials.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO GIT REPOSITORIES.
# =============================================================================

spring.application.name=Coop_Vsit_hub

# Database Credentials
spring.datasource.url=jdbc:postgresql://localhost:5432/coop_visit_db
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA & Migration Settings
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

# MailHog / SMTP Credentials
spring.mail.host=localhost
spring.mail.port=1025

# File Limits
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# Security & Secret Keys (REPLACE WITH STRONG PRODUCTION RANDOM KEY)
coopbank.security.jwt.secret=REPLACE_WITH_STRONG_256BIT_SECRET_KEY_FOR_PRODUCTION
coopbank.security.jwt.access-token-expiration-ms=900000
coopbank.security.jwt.refresh-token-expiration-ms=604800000
coopbank.security.brute-force.max-attempts=5
coopbank.security.brute-force.lock-duration-minutes=15

# Server Port
server.port=8080
