# =============================================================================
# CoopBank Visit Hub - Environment Variables Template (.env.example)
# DO NOT COMMIT SENSITIVE VALUES OR REAL PASSWORDS TO GIT.
# Copy this file to .env and configure your local or production credentials.
# =============================================================================

# Server Port
PORT=8081

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/coop_visit_db
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# Docker Compose Database Settings
POSTGRES_DB=coop_visit_db
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password

# Security & JWT Secrets (Provide a secure random 256-bit base64/hex key)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Default System Administrator Account (Local Portal Sign-In Template)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=your_default_admin_password_here
DEFAULT_ADMIN_EMAIL=admin@example.com

# Swagger UI Credentials
SWAGGER_ADMIN_USER=admin-username-set-here
SWAGGER_ADMIN_PASS=your_swagger_password_here

# Application URLs
APP_BASE_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000
COOPBANK_APP_FRONTEND_URL=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# SMTP Mail Relay Settings
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply@example.com
SPRING_MAIL_PASSWORD=your_mail_password
SPRING_MAIL_FROM=noreply@example.com
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true
SPRING_MAIL_STARTTLS_REQUIRED=true
SPRING_MAIL_SSL_TRUST=*
SPRING_MAIL_SSL_CHECKSERVERIDENTITY=false

# Active Directory (AD / LDAPS) Integration Settings
AD_ENABLED=false
AD_DOMAIN=example.local
AD_URL=ldaps://ldap.example.com:636
AD_BASE_DN=DC=example,DC=local
AD_USERNAME=
AD_PASSWORD=
AD_SSL_TRUST_ALL=false
